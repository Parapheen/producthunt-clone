# Database Configuration
DATABASE_URL=file:./data.db

# Authentication
YANDEX_CLIENT_ID=your_yandex_client_id_here
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VK_CLIENT_ID=your_vk_client_id_here
VK_CLIENT_SECRET=your_vk_client_secret_here
SESSION_SECRET=your_very_secure_session_secret_key_here

# Telegram Bot (Optional - for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Application Settings
ENVIRONMENT=development
BASE_URL=http://localhost:3333
PORT=3333
GOOGLE_REDIRECT_URL=http://localhost:3333/auth/google/callback
YANDEX_REDIRECT_URL=http://localhost:3333/auth/yandex/callback
VK_REDIRECT_URL=http://localhost:3333/auth/vk/callback

# Server Timeouts (optional)
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# Session Settings (optional)
SESSION_MAX_AGE=24h

# Storage
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=assets/uploads
PUBLIC_UPLOAD_BASE=/assets/uploads
# For S3
# S3_BUCKET=your-bucket
# S3_BASE_KEY=uploads
